PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/spendwise
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Configure these to enable forgot-password emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Configure Twilio to deliver scheduled SMS and WhatsApp messages.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
